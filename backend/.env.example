# GreenCampus AI — Backend Environment Variables
# Copy this file to .env and fill in your Gemini API key:
#   cp .env.example .env
#
# Get your free Gemini API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Model name (options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
