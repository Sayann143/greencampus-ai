# GreenCampus AI — Backend Environment Configuration Example
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: All keys are optional!
# If an AI key is omitted or quota is exceeded, GreenCampus AI automatically
# falls back gracefully through the 4-tier pipeline:
# Gemini -> xAI Grok -> OpenAI -> Local Rule-based Classifier.

# ── Tier 1: Google Gemini (Primary) ──────────────────────────────────────────
# Free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Tier 2: xAI Grok (First Fallback) ────────────────────────────────────────
# API key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest

# ── Tier 3: OpenAI (Second Fallback) ─────────────────────────────────────────
# API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Database: PostgreSQL (Production Persistence) ───────────────────────────
# If unset, the server automatically uses local SQLite (greencampus.db).
# For permanent persistence on Render, provide your Supabase/Neon/Render PostgreSQL URL:
# Example: postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
DATABASE_URL=

# ── CORS & Deployment ────────────────────────────────────────────────────────
# Additional allowed frontend URLs (comma-separated, without trailing slash)
# Vercel *.vercel.app and localhost:5173 are already allowed by default.
FRONTEND_URL=https://greencampus-ai-pi.vercel.app
ALLOWED_ORIGINS=https://greencampus-ai-pi.vercel.app
